# Shared demo token (saas caller ↔ api callee)
INTEGRITY_SHARED_TOKEN=demo-integrity-token
IVS_SHARED_TOKEN=demo-integrity-token
IVS_REQUIRE_TOKEN=false
IVS_CONTRACT_VERSION=0.1.0

# SaaS → IVS (compose service name when both run together)
INTEGRITY_ENABLED=true
INTEGRITY_API_BASE_URL=http://api:8090
