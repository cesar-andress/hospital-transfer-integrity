# Copy to .env and adjust as needed. Values below match docker-compose defaults.

# --- PostgreSQL (backend) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=saas_db

# --- FastAPI ---
SECRET_KEY=change-me-in-any-non-demo-environment
STORAGE_BASE_PATH=/app/vm_storage
FRONTEND_TRANSFER_URL=http://app.saas.local

# --- SMTP (MailHog in compose) ---
SMTP_HOST=mailhog
SMTP_PORT=1025

# --- Frontend (Vite) ---
VITE_API_URL=http://api.saas.local/api/v1

# --- Integrity Verification Service (Alessa TFG; stub by default) ---
INTEGRITY_ENABLED=true
INTEGRITY_API_BASE_URL=http://integrity-stub:8090
INTEGRITY_SHARED_TOKEN=demo-integrity-token
